{
  "name": "deepagents-sbx",
  "version": "0.1.0",
  "description": "Docker Sandboxes (sbx) microVM sandbox backend for Deep Agents",
  "keywords": [
    "deepagents",
    "docker-sandboxes",
    "sbx",
    "microvm",
    "ai-agents",
    "sandbox"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "deepagents": ">=1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "deepagents": "^1.14.1",
    "eslint": "^9.16.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restuhaqza/deepagents-sbx.git",
    "directory": "js"
  },
  "homepage": "https://github.com/restuhaqza/deepagents-sbx#readme",
  "bugs": {
    "url": "https://github.com/restuhaqza/deepagents-sbx/issues"
  }
}
